<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lukas.app.mapper.VideoMapper">
	<resultMap id="RentalResultMap" type="com.lukas.app.domain.Rental" >
		<id column="id" property="id" />
		<result column="user_id" property="userId" />
		<result column="video_id" property="videoId" />
		<result column="rented_at" property="rentedAt" />
		<result column="expires_at" property="expiresAt" />
		<result column="status" property="status" />
	</resultMap>
	<select id="findRentalsByUserId" resultMap="RentalResultMap">
			SELECT * FROM rentals
			WHERE user_id = #{userId}
	</select>
	
	<select id="findRentalByUserVideoAndStatus" resultMap="RentalResultMap">
			<![CDATA[
			SELECT * FROM rentals
			WHERE user_id = #{userId}
			  AND video_id = #{videoId}
			  AND status = #{status}
			  AND expires_at > NOW()
			]]>
	</select>
	
	<select id="insertRental">
			INSERT INTO rentals (user_id, video_id, rental_at, expires_at, status)
			VALUES (#{userId}, #{videoId}, NOW(), DATE_ADD(NOW(), INTERVAL 72 HOUR), #{status})
	</select>
	
</mapper>